'use strict';

const ThereFM = {
  state: {
    roomCode: 'LOCAL-01',
    connected: false,
    currentUser: {
      id: 'local-user',
      name: 'you',
      color: '#39ff88'
    },
    windows: new Set(),
    messages: []
  },

  init() {
    this.bindEvents();
    this.startClock();
    this.restoreSettings();
    this.setConnection('ready');
  },

  bindEvents() {
    document.querySelectorAll('[data-open]').forEach((button) => {
      button.addEventListener('click', () => {
        this.openWindow(button.dataset.open);
      });
    });

    document.querySelectorAll('[data-close]').forEach((button) => {
      button.addEventListener('click', () => {
        this.closeWindow(button.dataset.close);
      });
    });

    document.querySelectorAll('[data-minimize]').forEach((button) => {
      button.addEventListener('click', () => {
        this.minimizeWindow(button.dataset.minimize);
      });
    });

    document.querySelectorAll('[data-close-panel]').forEach((button) => {
      button.addEventListener('click', () => {
        const panel = document.getElementById(button.dataset.closePanel);
        if (panel) panel.style.display = 'none';
      });
    });

    document.querySelectorAll('.window').forEach((windowElement) => {
      windowElement.addEventListener('mousedown', () => {
        this.bringToFront(windowElement);
      });
    });

    document
      .getElementById('copyRoom')
      ?.addEventListener('click', () => this.copyRoomCode());

    document
      .getElementById('shareRoom')
      ?.addEventListener('click', () => this.shareRoom());

    document
      .getElementById('chatForm')
      ?.addEventListener('submit', (event) => {
        event.preventDefault();
        this.sendMessage();
      });

    document
      .getElementById('loadVideo')
      ?.addEventListener('click', () => this.loadVideo());

    document
      .getElementById('saveSettings')
      ?.addEventListener('click', () => this.saveSettings());

    document
      .getElementById('accentSelect')
      ?.addEventListener('change', (event) => {
        this.setAccent(event.target.value);
      });

    document
      .getElementById('densitySelect')
      ?.addEventListener('change', (event) => {
        document.body.classList.toggle(
          'comfortable',
          event.target.value === 'comfortable'
        );
      });
  },

  openWindow(name) {
    const element = document.getElementById(`${name}Window`);

    if (!element) {
      this.openPanel(name);
      return;
    }

    element.classList.remove('hidden');
    element.style.zIndex = String(Date.now());
    this.state.windows.add(name);

    document.getElementById('emptyState')?.classList.add('hidden');
  },

  closeWindow(id) {
    const element = document.getElementById(id);
    if (!element) return;

    element.classList.add('hidden');

    const name = id.replace('Window', '');
    this.state.windows.delete(name);

    if (this.state.windows.size === 0) {
      document.getElementById('emptyState')?.classList.remove('hidden');
    }
  },

  minimizeWindow(id) {
    const element = document.getElementById(id);
    if (!element) return;

    element.classList.toggle('minimized');
  },

  openPanel(name) {
    const panel = document.getElementById(name);
    if (!panel) return;

    panel.style.display = 'block';
  },

  bringToFront(element) {
    element.style.zIndex = String(Date.now());
  },

  startClock() {
    const clock = document.getElementById('clock');

    const update = () => {
      if (!clock) return;

      clock.textContent = new Date().toLocaleTimeString('pt-BR', {
        hour: '2-digit',
        minute: '2-digit'
      });
    };

    update();
    setInterval(update, 30000);
  },

  setConnection(status) {
    const label = document.getElementById('connectionText');
    const dot = document.getElementById('connectionDot');

    if (label) label.textContent = status;
    if (dot) dot.classList.toggle('offline', status !== 'online');

    this.state.connected = status === 'online';
  },

  async copyRoomCode() {
    try {
      await navigator.clipboard.writeText(this.state.roomCode);
      this.toast('room code copied');
    } catch {
      this.toast('copy unavailable');
    }
  },

  async shareRoom() {
    const shareData = {
      title: 'there.fm',
      text: `Join workspace ${this.state.roomCode}`,
      url: window.location.href
    };

    try {
      if (navigator.share) {
        await navigator.share(shareData);
      } else {
        await navigator.clipboard.writeText(window.location.href);
        this.toast('workspace link copied');
      }
    } catch {
      this.toast('share cancelled');
    }
  },

  sendMessage() {
    const input = document.getElementById('chatInput');
    const messages = document.getElementById('messages');

    if (!input || !messages || !input.value.trim()) return;

    const text = input.value.trim().slice(0, 500);
    const message = document.createElement('div');

    message.className = 'message';

    const author = document.createElement('b');
    author.textContent = this.state.currentUser.name;

    const content = document.createElement('span');
    content.textContent = text;

    message.append(author, content);
    messages.appendChild(message);

    input.value = '';
    messages.scrollTop = messages.scrollHeight;

    this.state.messages.push({
      author: this.state.currentUser.name,
      text,
      createdAt: new Date().toISOString()
    });
  },

  loadVideo() {
    const input = document.getElementById('videoUrl');
    if (!input) return;

    try {
      const url = new URL(input.value.trim());

      if (!['http:', 'https:'].includes(url.protocol)) {
        throw new Error('invalid protocol');
      }

      this.toast('video URL accepted');
    } catch {
      this.toast('enter a valid http(s) URL');
    }
  },

  setAccent(accent) {
    document.body.classList.remove('amber', 'blue');

    if (accent === 'amber' || accent === 'blue') {
      document.body.classList.add(accent);
    }
  },

  saveSettings() {
    const settings = {
      accent: document.getElementById('accentSelect')?.value || 'green',
      density: document.getElementById('densitySelect')?.value || 'compact',
      motion: document.getElementById('motionToggle')?.checked ?? true
    };

    localStorage.setItem('there-fm-settings', JSON.stringify(settings));
    this.toast('settings applied');
  },

  restoreSettings() {
    try {
      const settings = JSON.parse(
        localStorage.getItem('there-fm-settings') || '{}'
      );

      if (settings.accent) {
        this.setAccent(settings.accent);

        const accent = document.getElementById('accentSelect');
        if (accent) accent.value = settings.accent;
      }

      if (settings.density) {
        document.body.classList.toggle(
          'comfortable',
          settings.density === 'comfortable'
        );

        const density = document.getElementById('densitySelect');
        if (density) density.value = settings.density;
      }

      if (typeof settings.motion === 'boolean') {
        const motion = document.getElementById('motionToggle');
        if (motion) motion.checked = settings.motion;

        document.body.classList.toggle('reduced-motion', !settings.motion);
      }
    } catch {
      localStorage.removeItem('there-fm-settings');
    }
  },

  toast(message) {
    const toast = document.getElementById('toast');
    if (!toast) return;

    toast.textContent = message;
    toast.classList.remove('hidden');

    clearTimeout(this.toastTimer);

    this.toastTimer = setTimeout(() => {
      toast.classList.add('hidden');
    }, 2400);
  }
};

document.addEventListener('DOMContentLoaded', () => {
  ThereFM.init();
});

window.ThereFM = ThereFM;
